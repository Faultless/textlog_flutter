<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The Flutter template grants this only in the debug profile, so without it a
	     release build is sandboxed with no outbound network and every screen errors.
	     Same trap as the missing INTERNET permission on Android. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
